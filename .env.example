# Binflip yapılandırması. Bu dosyayı .env olarak kopyala.
# DİKKAT: Özel anahtar ASLA bu dosyaya yazılmaz.

LOG_LEVEL=info

# Güvenlik kapıları: canlı işlem için İKİSİ de gerekir (DRY_RUN=0 ve LIVE_CONFIRMED=1).
DRY_RUN=1
LIVE_CONFIRMED=0

# Compose içinde varsayılanlar zaten tanımlı; dışarıda çalıştırırken doldur.
# DATABASE_URL=postgres://binflip:binflip@localhost:5432/binflip
# REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=
# HELIUS_API_KEY=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# POSTGRES_PASSWORD=binflip
