# Binflip yapılandırması. Bu dosyayı .env olarak kopyala.
# DİKKAT: Özel anahtar ASLA bu dosyaya yazılmaz.

LOG_LEVEL=info

# Güvenlik kapıları: canlı işlem için İKİSİ de gerekir (DRY_RUN=0 ve LIVE_CONFIRMED=1).
DRY_RUN=1
LIVE_CONFIRMED=0

# Compose içinde varsayılanlar zaten tanımlı; dışarıda çalıştırırken doldur.
# DATABASE_URL=postgres://binflip:binflip@localhost:5432/binflip
# REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=
# HELIUS_API_KEY=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# POSTGRES_PASSWORD=binflip

# İşlem ayarları
# PRIORITY_FEE_MICROLAMPORTS=50000
# SOL_RESERVE_LAMPORTS=100000000        # her kopyanın üstünde rent/ücret için boşta tutulan SOL (0.1)
# MAX_SWAP_IMPACT_BPS=500               # kapanışta token→SOL swap'ında en fazla %5 fiyat etkisi
# LISTENER_POLL_MS=5000

# Kâr süpürme: kapanıştan sonra bot cüzdanında KEEP + MIN üstü ne varsa ana cüzdana gider.
# Ana cüzdanın SADECE PUBLIC adresi yazılır (özel anahtarı asla).
# SWEEP_TO_ADDRESS=
# SWEEP_KEEP_LAMPORTS=5000000000        # bot cüzdanında kalacak çalışma sermayesi (5 SOL)
# SWEEP_MIN_LAMPORTS=500000000          # en az 0.5 SOL fazla birikince süpür
